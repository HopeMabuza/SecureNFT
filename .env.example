# Copy this file to .env and fill in your own values.
# Never commit .env.

# RPC endpoint for the Sepolia testnet (e.g. from Infura or Alchemy)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# Private key of the deployer wallet. Use a dedicated test wallet.
PRIVATE_KEY=0xyour_deployer_private_key_here

# Etherscan API key (optional, used for contract verification)
ETHERSCAN_API_KEY=

# IPFS URIs for token metadata
ROSE_BASEURI=ipfs://your_cid/0.json
LILY_BASEURI=ipfs://your_cid/1.json
